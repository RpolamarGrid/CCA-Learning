# Copy to .env and fill in real values for your environment.
# NEVER commit real secrets. These are placeholders only.

# --- Postgres (docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=change-me

# --- Redis (docker-compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT signing (generate a strong random 256-bit+ secret, do not reuse this example) ---
JWT_SIGNING_KEY=replace-with-a-long-random-base64-or-ascii-secret-0123456789

# --- PhonePe sandbox (placeholder sandbox-style values, never real credentials) ---
PHONEPE_MERCHANT_ID=SANDBOX_MERCHANT_ID
PHONEPE_SALT_KEY=SANDBOX_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost:8080/api/payments/phonepe/webhook
